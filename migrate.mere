// migrate.mere — create the blog schema and smoke-test the raw pg path.
//
// M0: prove the vendored host + contrib/db/pg round-trips before any typed
// layer exists. Connects, (re)creates the tables, seeds one post, reads it
// back through the raw `(str option list) list` interface.
//
// Run (dev):
//   mere -w migrate.mere > /tmp/m.wat
//   wat2wasm --enable-tail-call /tmp/m.wat -o /tmp/m.wasm
//   node .mere_host/run_wasm.js /tmp/m.wasm
//
// Assumes a trust-auth Postgres on 127.0.0.1:15499, database "blog" -- or
// wherever PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE point.

import "db/pg.mere";
import "config.mere";

// Connection settings: see config.mere. Defaults are what this file used to
// hardcode, so nothing in the README needs an environment set.

// DDL run as simple queries (no params). Order matters: comments -> posts
// on drop (FK), posts -> comments on create.
let migration_1 = [
  "CREATE TABLE users ( \
   id serial PRIMARY KEY, \
   username text UNIQUE NOT NULL, \
   pw_hash text NOT NULL, \
   created_at timestamptz NOT NULL DEFAULT now() );",
  // Sessions live here rather than in a process-local Map (see session_pg.mere):
  // the server serves requests concurrently now, and a shared Map loses writes.
  // ON DELETE CASCADE so removing a user removes their sessions -- the in-memory
  // store had no such relationship to express.
  "CREATE TABLE sessions ( \
   sid text PRIMARY KEY, \
   username text NOT NULL REFERENCES users(username) ON DELETE CASCADE, \
   created_at timestamptz NOT NULL DEFAULT now() );",
  "CREATE TABLE posts ( \
   id serial PRIMARY KEY, \
   author text NOT NULL DEFAULT '', \
   title text NOT NULL, \
   body text NOT NULL, \
   published boolean NOT NULL DEFAULT false, \
   created_at timestamptz NOT NULL DEFAULT now() );",
  "CREATE TABLE comments ( \
   id serial PRIMARY KEY, \
   post_id integer NOT NULL REFERENCES posts(id) ON DELETE CASCADE, \
   author text NOT NULL, \
   body text NOT NULL, \
   created_at timestamptz NOT NULL DEFAULT now() );"
];

let rec run_all = fn (fd: int) -> fn (stmts: str list) ->
  match stmts with
  | Nil -> ()
  | Cons (sql, rest) ->
    let _ = pg_query fd sql in
    run_all fd rest
  ;

let rec print_rows = fn (rows: (str option list) list) ->
  match rows with
  | Nil -> ()
  | Cons (row, rest) ->
    let _ = print ("  row: " ++ pg_val_or (pg_col_at row 0) "?"
                   ++ " | " ++ pg_val_or (pg_col_at row 1) "?"
                   ++ " | published=" ++ pg_val_or (pg_col_at row 2) "?") in
    print_rows rest
  ;

// ---- a migration runner (v0.1.340 arc) ---------------------------------
//
// This file used to DROP every table and recreate it. That is fine for a demo
// that is always started from nothing and destroys the database of anyone who
// runs it twice -- which is the difference between "a schema" and "migrations",
// and the difference nothing here had ever named.
//
// The runner is the smallest thing that is honestly one: a `schema_migrations`
// table, a numbered list, and applying only what is not there. Each version's
// statements run and its number is recorded in the SAME transaction, so a
// migration that fails halfway does not leave itself marked as applied.
//
// RESET IS NOW EXPLICIT. `migrate.mere --reset` drops everything first; without
// it, running this twice is a no-op rather than data loss.

// Every post gets a slug.
//
// WRITTEN FOR A TABLE THAT ALREADY HAS ROWS. The one-line version of this --
// ALTER TABLE posts ADD COLUMN slug text NOT NULL -- is valid against zero rows
// and impossible against any, so it passes on a fresh database and cannot be
// applied to a real one. Migrations are normally tested on empty databases,
// including by this repo's own verify.sh, which is the one input that cannot
// fail.
//
// So: the column arrives nullable, every existing row is given a value, and
// only then is the constraint imposed. An empty title still yields a slug,
// because a post with no title is a row this has to convert rather than drop.
let migration_2 = [
  "ALTER TABLE posts ADD COLUMN slug text;",
  "UPDATE posts SET slug = lower(regexp_replace(coalesce(nullif(title, ''), 'post-' || id), '[^a-zA-Z0-9]+', '-', 'g')) WHERE slug IS NULL;",
  "ALTER TABLE posts ALTER COLUMN slug SET NOT NULL;"
];

let migrations = [
  (1, migration_1),
  (2, migration_2)
];

let ensure_table = fn (fd: int) ->
  pg_query fd "CREATE TABLE IF NOT EXISTS schema_migrations ( \
                 version integer PRIMARY KEY, \
                 applied_at timestamptz NOT NULL DEFAULT now() )";

let is_applied = fn (fd: int) -> fn (v: int) ->
  match pg_query_params fd "SELECT 1 FROM schema_migrations WHERE version = $1"
          [Some (show v)] with
  | Nil -> false
  | Cons (_, _) -> true
  ;

let rec apply_each = fn (fd: int) -> fn (ms: (int * str list) list) -> fn (n: int) ->
  match ms with
  | Nil -> n
  | Cons ((v, stmts), rest) ->
    if is_applied fd v then
      let _ = print ("  " ++ str_of_int v ++ " already applied") in
      apply_each fd rest n
    else
      // The statements and the bookkeeping in one transaction: a migration that
      // fails partway must not be recorded as done, or the next run skips it and
      // the schema is silently wrong from then on.
      let _ = pg_query fd "BEGIN" in
      let _ = run_all fd stmts in
      let _ = pg_query_params fd
                "INSERT INTO schema_migrations (version) VALUES ($1)" [Some (show v)] in
      let _ = pg_query fd "COMMIT" in
      let _ = print ("  " ++ str_of_int v ++ " applied") in
      apply_each fd rest (n + 1)
  ;

let reset_sql = [
  "DROP TABLE IF EXISTS comments;",
  "DROP TABLE IF EXISTS posts;",
  "DROP TABLE IF EXISTS sessions;",
  "DROP TABLE IF EXISTS users;",
  "DROP TABLE IF EXISTS schema_migrations;"
];

let rec wants_reset = fn (a: str list) ->
  match a with
  | Nil -> false
  | Cons (x, rest) -> if str_eq x "--reset" then true else wants_reset rest
  ;

let seed_if_empty = fn (fd: int) ->
  match pg_query fd "SELECT 1 FROM posts LIMIT 1" with
  | Cons (_, _) -> print "seed: posts already present, left alone"
  | Nil ->
    let _ = pg_query_params fd
              "INSERT INTO posts (title, body, published) VALUES ($1, $2, $3)"
              [Some "Hello Mere", Some "First post from Mere.", Some "true"] in
    print "seed: one post"
  ;

let run = fn () ->
  let fd = pg_connect db_host db_port db_user db_pass db_name in
  if fd < 1 then print "connect failed"
  else
    let _ = print "connected" in
    let _ = if wants_reset (args ()) then
              let _ = run_all fd reset_sql in print "reset: dropped every table"
            else () in
    let _ = ensure_table fd in
    let _ = print "migrations:" in
    let applied = apply_each fd migrations 0 in
    // The line verify.sh greps for. It says how many ran, so "nothing to do"
    // and "everything ran" are different messages rather than the same one.
    let _ = print ("schema created (" ++ str_of_int applied ++ " applied)") in
    let _ = seed_if_empty fd in
    let rows = pg_query fd "SELECT id, title, published FROM posts ORDER BY id" in
    let _ = print "posts:" in
    let _ = print_rows rows in
    pg_close fd
  ;

run ()
