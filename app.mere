// app.mere — M2: the blog served over HTTP.
//
// Wires contrib/http (router + json body) to the typed model layer. JSON
// responses use `to_json` (mere v0.1.6), which serializes a typed record /
// list structurally — so there are no hand-written JSON writers here.
//
// Run:
//   mere -c app.mere > app.c && clang -O2 app.c -lssl -lcrypto -o blog
//   ./blog                                                # serves :8080
//
// Configuration comes from the environment (see config.mere) -- PGHOST,
// PGPORT, PGUSER, PGPASSWORD, PGDATABASE, PORT, and TLS_CERT / TLS_KEY. The
// defaults are what this file used to hardcode, so it still starts with an
// empty environment and a trust-auth Postgres on 127.0.0.1:15499 (db "blog");
// run migrate.mere first to create the schema.
//
// Set TLS_CERT and TLS_KEY and it serves HTTPS itself, terminating TLS
// in-process.

import "db/pg.mere";
import "config.mere";
import "model.mere";
import "http/http.mere";
// TLS is opt-in by importing the module that declares it (mere v0.1.339):
// this line is what links OpenSSL for the serving side. Without it the app
// still builds and still serves -- plaintext.
import "http/tls.mere";
// The worker pool, and its own TLS module for the same opt-in reason.
import "http/serve_mt.mere";
import "http/serve_mt_tls.mere";
import "http/router.mere";
import "http/json_body.mere";
// Sessions in Postgres, not in a process-local Map: the server is concurrent
// now and a shared Map loses writes. See session_pg.mere.
import "session_pg.mere";
// The rules the admin form checks before it submits. Same module, two
// compilations: C here, Wasm in the browser client.
import "validate.mere";

// ONE CONNECTION PER WORKER, built by the worker and never shared. This used
// to be a single process-wide `fd`, which was correct only because the accept
// loop was sequential: two requests interleaving on one Postgres socket
// corrupt the protocol. `http_serve_mt_ctx` calls this once per worker and
// hands the result to every request that worker serves, so there is no shared
// pool to check a connection out of -- and therefore no way for a handler that
// fails to forget to give one back.
let mk_conn = fn (i: int) ->
  let c = pg_connect db_host db_port db_user db_pass db_name in
  let _ =
    if c < 1 then print_err ("worker " ++ str_of_int i ++ ": pg connect FAILED")
    else print ("worker " ++ str_of_int i ++ ": pg " ++ db_user ++ "@" ++ db_host
                ++ ":" ++ str_of_int db_port ++ "/" ++ db_name) in
  c;

// Password hashing. sha256_hex is a host extern (contrib/db uses it for
// SCRAM). Demo-grade: a fixed pepper, no per-user salt or key stretching —
// a real app would use a slow salted KDF. Good enough to exercise the
// signup/login/session flow.
extern fn sha256_hex: str -> str;
let hash_pw = fn (p: str) -> sha256_hex ("mere-blog::pepper::" ++ p);

// --- JSON responses via `to_json` (mere v0.1.6) --------------------------
//
// `to_json` serializes any value structurally: a record's field set IS its
// JSON object, a list becomes an array. So `to_json p` / `to_json (posts_all
// fd)` replace the per-model writers that used to live here — the whole
// hand-written JSON layer collapses. Two spots use a *projection* record
// instead of the raw model:
//   - users must never leak `pw_hash`, so serialize a public projection;
//   - the show-post response is a composite (post + its comments).

// A user's public shape — deliberately omits pw_hash (to_json on a `User`
// would include it).
type UserPublic = { id: int, username: str };
let user_public = fn (u: User) -> UserPublic { id = u.id, username = u.username };

// GET /api/posts/:id response shape (to_json handles the nesting).
type PostView = { post: Post, comments: Comment list };

// A trivial {"ok": true} acknowledgement.
type OkResp = { ok: bool };

// --- request bodies: decoded with of_json_opt (mere v0.1.7) ---------------
//
// of_json_opt : str -> 'a option returns None on ANY parse / shape error, so
// a malformed or incomplete request body yields a clean 400 instead of
// crashing the server (of_json's fail-fast is for trusted input only). It
// replaces the hand-rolled `body_field "x"` field-plucking. Every field is
// required (present in the JSON object); optional-with-default isn't modeled.
type Credentials = { username: str, password: str };
type NewPost = { title: str, body: str, published: bool };
type NewComment = { author: str, body: str };

// --- response helpers -----------------------------------------------------

// 422 with the field errors as JSON — the shape the admin form renders
// next to each input. The server runs the same `validate_*` the client
// ran, because a client that skipped it is exactly the case this catches.
let json_errors = fn (errs) ->
  let _ = http_set_status 422 in
  let _ = http_set_content_type "application/json" in
  to_json errs ++ "\n"
  ;

let json_ok = fn (body: str) ->
  let _ = http_set_content_type "application/json" in body ++ "\n"
  ;

let _first_cap = fn (caps: str list) ->
  match caps with
  | Nil -> ""
  | Cons (h, _) -> h
  ;

let _unauthorized = fn (u: unit) ->
  let _ = http_set_status 401 in "login required\n"
  ;

// --- auth handlers --------------------------------------------------------

let signup_h = fn (fd: int) -> fn (req: str) ->
  match (of_json_opt (http_current_body ()) : Credentials option) with
  | None -> let _ = http_set_status 400 in "username and password required\n"
  | Some creds ->
    match validate_credentials creds.username creds.password with
    | Cons (e, es) -> json_errors (Cons (e, es))
    | Nil ->
      match user_find_by_name fd creds.username with
      | Some _ -> let _ = http_set_status 409 in "username taken\n"
      | None ->
        match user_create fd creds.username (hash_pw creds.password) with
        | None -> let _ = http_set_status 500 in "signup failed\n"
        | Some u ->
          let _ = session_pg_login fd u.username in
          let _ = http_set_status 201 in json_ok (to_json (user_public u))
  ;

let login_h = fn (fd: int) -> fn (req: str) ->
  match (of_json_opt (http_current_body ()) : Credentials option) with
  | None -> let _ = http_set_status 401 in "invalid credentials\n"
  | Some creds ->
    match user_find_by_name fd creds.username with
    | None -> let _ = http_set_status 401 in "invalid credentials\n"
    | Some u ->
      if str_eq u.pw_hash (hash_pw creds.password) then
        let _ = session_pg_login fd u.username in json_ok (to_json (user_public u))
      else
        let _ = http_set_status 401 in "invalid credentials\n"
  ;

let logout_h = fn (fd: int) -> fn (req: str) ->
  let _ = session_pg_logout fd in
  json_ok (to_json (OkResp { ok = true }))
  ;

let me_h = fn (fd: int) -> fn (req: str) ->
  let username = session_pg_current fd in
  if str_eq username "" then _unauthorized ()
  else
    match user_find_by_name fd username with
    | None -> _unauthorized ()
    | Some u -> json_ok (to_json (user_public u))
  ;

// --- handlers -------------------------------------------------------------

let posts_index_h = fn (fd: int) -> fn (req: str) ->
  json_ok (to_json (posts_all fd))
  ;

let post_show_h = fn (fd: int) -> fn (caps: str list) -> fn (req: str) ->
  let id = parse_int_or_zero (_first_cap caps) in
  match post_find fd id with
  | None -> let _ = http_set_status 404 in "post not found\n"
  | Some p ->
    let cs = comments_for fd id in
    json_ok (to_json (PostView { post = p, comments = cs }))
  ;

let post_create_h = fn (fd: int) -> fn (req: str) ->
  let user = session_pg_current fd in
  if str_eq user "" then _unauthorized ()
  else
    match (of_json_opt (http_current_body ()) : NewPost option) with
    | None -> let _ = http_set_status 400 in "title, body and published required\n"
    | Some np ->
      match validate_post np.title np.body with
      | Cons (e, es) -> json_errors (Cons (e, es))
      | Nil ->
        match post_create fd user np.title np.body np.published with
        | None -> let _ = http_set_status 500 in "create failed\n"
        | Some p -> let _ = http_set_status 201 in json_ok (to_json p)
  ;

let comment_create_h = fn (fd: int) -> fn (caps: str list) -> fn (req: str) ->
  let pid = parse_int_or_zero (_first_cap caps) in
  match (of_json_opt (http_current_body ()) : NewComment option) with
  | None -> let _ = http_set_status 400 in "author and body required\n"
  | Some nc ->
    match validate_comment nc.author nc.body with
    | Cons (e, es) -> json_errors (Cons (e, es))
    | Nil ->
      match comment_create fd pid nc.author nc.body with
      | None -> let _ = http_set_status 500 in "comment failed\n"
      | Some c -> let _ = http_set_status 201 in json_ok (to_json c)
  ;

// Update / delete require login AND ownership: only a post's own author
// may mutate it. Look the post up first so we can compare authors and
// distinguish 404 (no such post) from 403 (someone else's).
let post_update_h = fn (fd: int) -> fn (caps: str list) -> fn (req: str) ->
  let user = session_pg_current fd in
  if str_eq user "" then _unauthorized ()
  else
    let id = parse_int_or_zero (_first_cap caps) in
    match post_find fd id with
    | None -> let _ = http_set_status 404 in "post not found\n"
    | Some existing ->
      if str_eq existing.author user then
        let title = body_field "title" in
        let body = body_field "body" in
        let published = str_eq (body_field "published") "true" in
        if str_eq title "" then
          let _ = http_set_status 400 in "title required\n"
        else
          (match post_update fd id title body published with
           | None -> let _ = http_set_status 404 in "post not found\n"
           | Some p -> json_ok (to_json p))
      else
        let _ = http_set_status 403 in "not your post\n"
  ;

let post_delete_h = fn (fd: int) -> fn (caps: str list) -> fn (req: str) ->
  let user = session_pg_current fd in
  if str_eq user "" then _unauthorized ()
  else
    let id = parse_int_or_zero (_first_cap caps) in
    match post_find fd id with
    | None -> let _ = http_set_status 404 in "post not found\n"
    | Some existing ->
      if str_eq existing.author user then
        let _ = post_delete fd id in
        let _ = http_set_status 204 in ""
      else
        let _ = http_set_status 403 in "not your post\n"
  ;

// A tiny HTML index so `GET /` is human-friendly (the Rails feel).
let rec _posts_html = fn (ps: Post list) -> fn (acc: str) ->
  match ps with
  | Nil -> acc
  | Cons (p, rest) ->
    _posts_html rest
      (acc ++ "<li><b>" ++ p.title ++ "</b> — " ++ p.body ++ "</li>")
  ;

let index_h = fn (fd: int) -> fn (req: str) ->
  let _ = http_set_content_type "text/html" in
  "<!doctype html><html><body><h1>mere-blog</h1><ul>"
    ++ _posts_html (posts_published fd) ""
    ++ "</ul></body></html>"
  ;

// The admin client: one page, one Wasm module, one host glue. read_file
// is binary-safe (a Mere str carries its length), so the .wasm goes out
// through the same path as the HTML.
let admin_page = fn (fd: int) -> fn (req: str) ->
  let _ = http_set_content_type "text/html; charset=utf-8" in
  read_file "admin.html"
  ;

let admin_wasm = fn (fd: int) -> fn (req: str) ->
  let _ = http_set_content_type "application/wasm" in
  read_file "admin.wasm"
  ;

let admin_glue = fn (fd: int) -> fn (req: str) ->
  let _ = http_set_content_type "application/javascript; charset=utf-8" in
  read_file ".mere_modules/dom/dom.glue.js"
  ;

let not_found = fn (fd: int) -> fn (req: str) ->
  let _ = http_set_status 404 in "not found\n"
  ;

// --- routes + serve -------------------------------------------------------

// The table is built per request rather than once, because every handler now
// needs the worker's connection and the router's handler type has no room for
// it. Fourteen small allocations against a database round trip, all of them
// reclaimed by the per-request arena.
let routes = fn (fd: int) -> [
  route "GET" "/" (index_h fd),
  route "GET" "/admin" (admin_page fd),
  route "GET" "/admin.wasm" (admin_wasm fd),
  route "GET" "/dom.glue.js" (admin_glue fd),
  route "POST" "/api/signup" (signup_h fd),
  route "POST" "/api/login" (login_h fd),
  route "POST" "/api/logout" (logout_h fd),
  route "GET" "/api/me" (me_h fd),
  route "GET" "/api/posts" (posts_index_h fd),
  route_pattern "GET" "/api/posts/:id" (post_show_h fd),
  route "POST" "/api/posts" (post_create_h fd),
  route_pattern "PUT" "/api/posts/:id" (post_update_h fd),
  route_pattern "DELETE" "/api/posts/:id" (post_delete_h fd),
  route_pattern "POST" "/api/posts/:id/comments" (comment_create_h fd)
];

let handle = fn (fd: int) -> fn (req: str) -> router (routes fd) (not_found fd) req;

// Serve TLS ourselves when we are given a certificate. Before mere v0.1.338
// there was no `else` here to choose: a Mere program could dial a TLS
// connection but not answer one, so this app served cleartext -- and said
// nothing about it, because there was nothing to say. The README described
// `./mere-blog # serves :8080` and moved on. A capability nobody asks for
// leaves no workaround behind, and so no trace that anything is missing.
let _ =
  if str_len tls_cert > 0 then
    let _ = print ("mere-blog serving https on :" ++ str_of_int http_port
                   ++ " (cert " ++ tls_cert ++ ", " ++ str_of_int http_workers
                   ++ " workers)") in
    http_serve_mt_ctx_tls http_port http_workers tls_cert tls_key mk_conn handle
  else
    let _ = print ("mere-blog serving http on :" ++ str_of_int http_port
                   ++ " (set TLS_CERT and TLS_KEY for https)") in
    http_serve_mt_ctx http_port http_workers mk_conn handle;
0
