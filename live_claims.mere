// live_claims.mere — what contrib/db/live claims about THIS application's
// statements, for this application's database to judge.
//
// The upstream gate checks the derivation against a schema written to exercise
// it. This one takes the reads out of model.mere and session_pg.mere and the
// schema out of migrate.mere, so what is being judged is the app, not a
// fixture that was arranged to pass.
//
// Prints "<write> <read> yes|no" per pair; live_soundness.sh executes both
// against Postgres and compares the claim to what actually changed.
import "db/live.mere";

// The column lists model.mere builds its SELECTs from.
let _post_cols = "id, author, title, body, published, created_at";
let _comment_cols = "id, post_id, author, body, created_at";
let _user_cols = "id, username, pw_hash";

let reads = [
  ("r_posts_all",   "SELECT " ++ _post_cols ++ " FROM posts ORDER BY id DESC"),
  ("r_posts_pub",   "SELECT " ++ _post_cols ++ " FROM posts WHERE published = true ORDER BY id DESC"),
  ("r_post_find",   "SELECT " ++ _post_cols ++ " FROM posts WHERE id = 1"),
  ("r_comments",    "SELECT " ++ _comment_cols ++ " FROM comments WHERE post_id = 1 ORDER BY id"),
  ("r_user_byname", "SELECT " ++ _user_cols ++ " FROM users WHERE username = 'alice'"),
  ("r_session",     "SELECT username FROM sessions WHERE sid = 's1'")
];

let writes = [
  ("w_post_create",    "INSERT INTO posts (author, title, body, published) VALUES ('a','t','b',true)"),
  ("w_post_update",    "UPDATE posts SET title = 'x', body = 'y', published = true WHERE id = 1"),
  ("w_post_delete",    "DELETE FROM posts WHERE id = 1"),
  ("w_comment_create", "INSERT INTO comments (post_id, author, body) VALUES (1,'a','c')"),
  ("w_user_create",    "INSERT INTO users (username, pw_hash) VALUES ('carol','h')"),
  ("w_user_delete",    "DELETE FROM users WHERE username = 'alice'"),
  ("w_session_login",  "INSERT INTO sessions (sid, username) VALUES ('s9','alice')"),
  ("w_session_logout", "DELETE FROM sessions WHERE sid = 's1'")
];

// The schema as migrate.mere writes it. Both cascades are here, and the second
// one -- sessions.username -> users -- is not in the upstream fixture: deleting
// a user takes their sessions with it, so a read of sessions goes stale from a
// write that never names that table.
let ddl = "CREATE TABLE users (id serial PRIMARY KEY, username text UNIQUE NOT NULL, pw_hash text NOT NULL); \
CREATE TABLE sessions (sid text PRIMARY KEY, username text NOT NULL REFERENCES users(username) ON DELETE CASCADE, created_at timestamptz NOT NULL DEFAULT now()); \
CREATE TABLE posts (id serial PRIMARY KEY, author text NOT NULL, title text NOT NULL, body text NOT NULL, published boolean NOT NULL DEFAULT false, created_at timestamptz NOT NULL DEFAULT now()); \
CREATE TABLE comments (id serial PRIMARY KEY, post_id integer NOT NULL REFERENCES posts(id) ON DELETE CASCADE, author text NOT NULL, body text NOT NULL, created_at timestamptz NOT NULL DEFAULT now());";

let casc = cascades_of ddl;

let rec each_read = fn (wn: str) -> fn (ws: str) -> fn (rs) ->
  match rs with
  | Nil -> ()
  | Cons ((rn, rq), rest) ->
    let _ = print (wn ++ " " ++ rn ++ " " ++ (if affects_via casc ws rq then "yes" else "no")) in
    each_read wn ws rest
  ;

let rec each_write = fn (ws) ->
  match ws with
  | Nil -> ()
  | Cons ((wn, wq), rest) -> let _ = each_read wn wq reads in each_write rest
  ;

let _ = print ("cascades " ++ show casc) in
let _ = each_write writes in
print "claims: 48 pairs"
