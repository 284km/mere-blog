// boundary/v1.mere — the wire shape after migration 2 exposes the slug.
//
// A released version is not a note about the past: admin.wasm is downloaded
// and cached by a browser, so a client running last week's build calls this
// week's server on every deploy. The API's JSON is derived from model.mere's
// record by `to_json`, which means CHANGING THAT RECORD CHANGES THE WIRE, and
// nothing in the type says so.
//
//   <prog> encode          this version's payload
//   <prog> decode <json>   "ok" if this version can read it, "fail" if not
type Post = {
  id: int,
  author: str,
  title: str,
  body: str,
  published: bool,
  created_at: str,
  slug: str
};

let sample = Post { id = 1, author = "alice", title = "first", body = "b",
                    published = true, created_at = "2026-08-29T00:00:00Z", slug = "first" };

match args () with
| Cons (mode, rest) ->
  if str_eq mode "encode" then print (to_json sample)
  else
    (match rest with
     | Cons (payload, _) ->
       (match (of_json_opt payload : Post option) with
        | Some _ -> print "ok"
        | None -> print "fail")
     | Nil -> print "fail")
| Nil -> print "fail"
